# ==============================================================================
# Job Match Assistant - Environment Configuration Example
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Required Configurations (Must be defined, app will fail fast if missing)
# ------------------------------------------------------------------------------

# Scraper source identifier (e.g., apify_linkedin, apify_indeed)
SCRAPER_SOURCE=apify_linkedin

# Apify API token (Secret value, optional in config but required at client run)
APIFY_API_TOKEN=your_apify_api_token_here

# Apify Actor ID (e.g. apify/linkedin-jobs-scraper)
APIFY_ACTOR_ID=apify/linkedin-jobs-scraper

# Replay from cache flag (True/False, defaults to False)
REPLAY_FROM_CACHE=False

# Specific JSON cache file path to replay from (relative to project root). If not set, latest is used.
# REPLAY_CACHE_PATH=data/raw_scrapes/scrape_apify_linkedin_latest.json

# API key for the selected LLM provider (Secret value)
LLM_API_KEY=your_llm_api_key_here

# ------------------------------------------------------------------------------
# Optional Path Configurations
# ------------------------------------------------------------------------------

# Path to the SQLite database file (default: data/app.db)
DATABASE_PATH=data/app.db

# Directory where raw scrape json files are saved (default: data/raw_scrapes)
RAW_SCRAPE_DIR=data/raw_scrapes

# Path to the excel ledger output target (default: data/ledger.xlsx)
LEDGER_XLSX_PATH=data/ledger.xlsx

# Directory where local knowledge artifacts/files are stored (default: data/knowledge)
KNOWLEDGE_DIR=data/knowledge

# Path to the rotating log file (default: data/app.log)
LOG_FILE_PATH=data/app.log

# ------------------------------------------------------------------------------
# Google Sheets Ledger (optional - the pipeline runs without it)
# ------------------------------------------------------------------------------

# Path to the Google Cloud service account JSON key (default: secrets/service_account.json)
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/service_account.json

# Spreadsheet ID from the sheet's URL, between /d/ and /edit. Leave blank to
# disable the mirror: runs complete normally and log a warning instead.
LEDGER_SHEET_ID=

# ------------------------------------------------------------------------------
# Scraper / Query Parameters
# ------------------------------------------------------------------------------

# Comma-separated job titles to search for. Each title is a separate Apify
# Actor Start, so cost scales with the number of titles. Duplicate titles
# (case-insensitive) are rejected at startup.
SCRAPER_QUERY=Software Engineer

# Maximum number of titles allowed in SCRAPER_QUERY (default: 5). More titles
# than this is a configuration error at startup, never silently truncated.
SCRAPER_MAX_QUERIES=5

# Scraper location filter
SCRAPER_LOCATION=Remote

# Maximum number of jobs/results to fetch per scraping run
SCRAPER_LIMIT=20

# Country filter passed through to the Apify actor (optional; actor-specific)
SCRAPER_COUNTRY=

# Recency window passed through to the actor, e.g. "7 days" (optional; actor-specific)
SCRAPER_POSTED_SINCE=

# ------------------------------------------------------------------------------
# LLM Settings
# ------------------------------------------------------------------------------

# LLM provider (e.g., openai, anthropic, google)
LLM_PROVIDER=openai

# Model name to use for standard skills processing
LLM_MODEL=gpt-4o

# Optional custom base URL for the LLM API provider
# LLM_BASE_URL=

# Maximum number of retry attempts for transient LLM request failures (default: 3)
LLM_MAX_RETRIES=3

# Request timeout limit in seconds per LLM attempt (default: 60)
LLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Scoring Configurations
# ------------------------------------------------------------------------------

# ATS scoring pass/fail/ranking threshold (integer in range 0-100)
SCORE_THRESHOLD=70

# ------------------------------------------------------------------------------
# Cost & Rate Settings (ROUGH ESTIMATES)
# ------------------------------------------------------------------------------

# Rate charged per LLM input token in USD. The default, 0.000005, is GPT-4o
# pricing ($5 per million). It MUST be set to match LLM_PROVIDER and LLM_MODEL,
# or cost_estimated_usd is meaningless. (Gemini 2.5 Flash paid tier: 0.0000003.)
LLM_INPUT_TOKEN_RATE_USD=0.000005

# Rate charged per LLM output token in USD. The default, 0.000015, is GPT-4o
# pricing ($15 per million). It MUST be set to match LLM_PROVIDER and LLM_MODEL,
# or cost_estimated_usd is meaningless. (Gemini 2.5 Flash paid tier: 0.0000025.)
LLM_OUTPUT_TOKEN_RATE_USD=0.000015

# Rate charged per Apify Compute Unit in USD (e.g. 0.25)
APIFY_CU_RATE_USD=0.25

# Apify charge per Actor Start in USD; a run makes one per SCRAPER_QUERY title (default: 0.01)
APIFY_ACTOR_START_USD=0.01

# Apify charge per result record in USD (default: 0.003)
APIFY_RESULT_USD=0.003

# Records the actor returns per unit of SCRAPER_LIMIT, used by the pre-run cost
# projection. The actor applies the limit per platform, so a query returns more
# records than its limit. Calibrated from nine envelopes (2026-09, all at limit
# 10, 35-45 records per query, a multiplier of 3.5-4.5); the default is the
# observed maximum so the projection does not under-report. Actor-specific, so
# adjust it if projections drift from actual spend.
SCRAPER_RESULTS_PER_LIMIT=4.5

# Refuse a run whose projected Apify cost exceeds this, in USD (default: 2.00).
# The run is recorded as failed. LLM cost is not part of the projection.
RUN_BUDGET_CAP_USD=2.00

# ------------------------------------------------------------------------------
# Runtime / Performance Configurations
# ------------------------------------------------------------------------------

# Concurrency limit for LLM calls (integer >= 1)
LLM_CONCURRENCY=5

# SQLite busy timeout limit in milliseconds
SQLITE_BUSY_TIMEOUT_MS=5000

# Standard logger output verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# User Interface Config
# ------------------------------------------------------------------------------

# Network address the UI runs on
UI_HOST=127.0.0.1

# Network port the UI runs on
UI_PORT=8080

# Seconds to wait after the last browser tab closes before shutting the server down
UI_EXIT_GRACE_SECONDS=5

# ------------------------------------------------------------------------------
# Cover Letter Export
# ------------------------------------------------------------------------------

# Your name, printed at the top of exported cover letter PDFs. Leave blank to
# omit it; the date and company are still shown.
CANDIDATE_NAME=
